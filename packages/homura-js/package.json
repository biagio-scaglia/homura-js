{
  "name": "@biagioscaglia/homurajs",
  "version": "1.2.1",
  "description": "HomuraJS — Time Travel State & History Engine for JavaScript (Git for application state)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biagio-scaglia/homura-js.git"
  },
  "bugs": {
    "url": "https://github.com/biagio-scaglia/homura-js/issues"
  },
  "homepage": "https://github.com/biagio-scaglia/homura-js#readme",
  "dependencies": {
    "@homura-js/core": "workspace:*",
    "@homura-js/devtools": "workspace:*",
    "@homura-js/vanilla": "workspace:*"
  },
  "keywords": [
    "state",
    "time-travel",
    "history",
    "dag",
    "undo",
    "redo",
    "branching",
    "diff",
    "snapshots",
    "git-for-state",
    "devtools",
    "homura",
    "homura-js",
    "homurajs"
  ],
  "author": "Biagio Scaglia",
  "license": "MIT"
}
