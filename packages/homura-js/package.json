{
  "name": "@biagioscaglia/homurajs",
  "version": "1.2.5",
  "description": "HomuraJS — Time Travel State & DAG History Engine for JavaScript (Git for application state)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.global.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biagio-scaglia/homura-js.git"
  },
  "bugs": {
    "url": "https://github.com/biagio-scaglia/homura-js/issues"
  },
  "homepage": "https://github.com/biagio-scaglia/homura-js#readme",
  "dependencies": {
    "@homura-js/core": "workspace:*",
    "@homura-js/devtools": "workspace:*",
    "@homura-js/vanilla": "workspace:*"
  },
  "keywords": [
    "state",
    "state-management",
    "time-travel",
    "time-travel-debugging",
    "dag",
    "history-graph",
    "undo-redo",
    "undo",
    "redo",
    "branching",
    "diff",
    "snapshots",
    "git-for-state",
    "immutable",
    "immutability",
    "proxy",
    "devtools",
    "redux-alternative",
    "zustand-alternative",
    "react-state",
    "vue-state",
    "vanillajs",
    "cdn",
    "standalone",
    "wordpress",
    "static-sites",
    "homura",
    "homura-js",
    "homurajs"
  ],
  "author": "Biagio Scaglia",
  "license": "MIT"
}
