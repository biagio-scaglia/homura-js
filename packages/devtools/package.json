{
  "name": "@homura-js/devtools",
  "version": "1.2.11",
  "description": "Modern Time Travel DevTools UI & Diagnostic Bridge for HomuraJS State Graphs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biagio-scaglia/homura-js.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/biagio-scaglia/homura-js/issues"
  },
  "homepage": "https://github.com/biagio-scaglia/homura-js#readme",
  "dependencies": {
    "@homura-js/core": "workspace:*"
  },
  "keywords": [
    "devtools",
    "redux-devtools",
    "time-travel",
    "time-travel-debugging",
    "history-graph",
    "timeline-visualizer",
    "diff-viewer",
    "state-inspector",
    "dag-visualizer",
    "homura"
  ],
  "author": "Biagio Scaglia",
  "license": "MIT"
}
