{
  "name": "@homura-js/react",
  "version": "1.2.1",
  "description": "React 18+ Integration for HomuraJS Time Travel State Engine with useSyncExternalStore",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biagio-scaglia/homura-js.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/biagio-scaglia/homura-js/issues"
  },
  "homepage": "https://github.com/biagio-scaglia/homura-js#readme",
  "dependencies": {
    "@homura-js/core": "workspace:*",
    "@homura-js/devtools": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "keywords": [
    "react",
    "react-hooks",
    "react18",
    "react19",
    "use-sync-external-store",
    "state",
    "state-management",
    "time-travel",
    "time-travel-debugging",
    "undo-redo",
    "history",
    "dag",
    "hooks",
    "devtools",
    "homura"
  ],
  "author": "Biagio Scaglia",
  "license": "MIT"
}
